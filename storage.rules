rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Avatar images: authenticated users can read avatars; only the owner can upload/modify
    match /users/{userId}/avatar/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ID card documents: strictly restricted to the owner
    match /users/{userId}/id_card/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Report evidence: authenticated users can read/write report evidence
    match /users/{userId}/evidence/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Default user folder fallback: owner only
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
