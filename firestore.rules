rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if a request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the authenticated user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to check if the authenticated user is an administrator
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the users collection
    match /users/{userId} {
      // Anyone authenticated can read their own profile, admins can read all profiles
      allow read: if isOwner(userId) || isAdmin();
      
      // When creating a profile, the user must be authenticated as that UID and must register with role 'user'
      allow create: if isAuthenticated() && 
                    isOwner(userId) && 
                    request.resource.data.role == 'user';
                    
      // When updating, users can edit their profile details but CANNOT modify their own role. Admins can update anything.
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      
      // Deleting profiles is restricted solely to administrators
      allow delete: if isAdmin();
    }

    // Rules for the incidents collection
    match /incidents/{incidentId} {
      // Authenticated users can create reports if they list themselves as the reporter
      allow create: if isAuthenticated() && 
                    request.resource.data.reporter.uid == request.auth.uid;
                    
      // Users can read only their own reports; admins can read all reports; staff with scope 'incidents' can read all reports
      allow read: if isAuthenticated() && 
                  (resource.data.reporter.uid == request.auth.uid || isAdmin() || (request.auth.token.role == 'staff' && request.auth.token.scope == 'incidents'));

      // Only admins and authorized staff may update a report, and only specific status/audit fields
      allow update: if (isAdmin() || (request.auth.token.role == 'staff' && request.auth.token.scope == 'incidents')) &&
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status', 'updatedAt', 'updatedBy', 'evidence', 'reviewerRemarks', 'adminRemarks']);

      // Deleting incident reports is strictly prohibited to preserve audit integrity
      allow delete: if false;
    }

    // Rules for the monitoring collection
    match /monitoring/{monitoringId} {
      // Authenticated users can create logs if they list themselves as the reporter
      allow create: if isAuthenticated() && 
                    request.resource.data.reporter.uid == request.auth.uid;
                    
      // Users can read only their own monitoring logs; admins can read all logs; authorized staff can read their specific category logs
      allow read: if isAuthenticated() && 
                  (resource.data.reporter.uid == request.auth.uid || isAdmin() || (request.auth.token.role == 'staff' && request.auth.token.scope == resource.data.category));

      // Only admins and authorized staff may update a monitoring log, and only specific status/audit fields
      allow update: if (isAdmin() || (request.auth.token.role == 'staff' && request.auth.token.scope == resource.data.category)) &&
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status', 'adminRemarks', 'reviewerRemarks', 'updatedAt', 'updatedBy', 'evidence']);

      // Deleting monitoring logs is prohibited
      allow delete: if false;
    }
  }
}

